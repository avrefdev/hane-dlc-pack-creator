{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hane DLC Pack Creator",
  "mainBinaryName": "Hane DLC Pack Creator",
  "version": "1.0.0",
  "identifier": "studio.hane.dlcpackcreator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hane DLC Pack Creator",
        "width": 860,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Hane Studios",
    "shortDescription": "GTA V DLC pack creator",
    "longDescription": "Creates ready to fill GTA V map and vehicle DLC packs.",
    "license": "MIT",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
